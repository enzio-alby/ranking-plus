# Copie este arquivo para ".env" (que fica FORA do git) e preencha os valores reais.
# Nunca comite o .env com segredos.

# ─── Banco de dados (MySQL / Laragon) ───────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=universidade_ranking

# ─── E-mail 2FA (Gmail App Password) ────────────────────────────
# Gere uma NOVA App Password em https://myaccount.google.com/apppasswords
# (a antiga que estava no código foi exposta e deve ser revogada)
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ─── Servidor ───────────────────────────────────────────────────
PORT=4000
# Lista de origens permitidas no CORS, separadas por vírgula. "null" cobre
# acesso via file:// (impersonation do admin, ver admin.js). Em produção (GCP),
# trocar pelo domínio real (ex: ALLOW_ORIGIN=https://ranking.seudominio.com).
ALLOW_ORIGIN=http://localhost:4000,null
